{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hosteldowntownlm",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": ".",
    "exclude": [
      ".git/**",
      ".github/**",
      ".gitignore",
      "*.py",
      "*.md",
      "*.log"
    ]
  },
  "observability": {
    "enabled": true
  }
}
